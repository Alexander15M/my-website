---
import BrandIcon from "./BrandIcon.astro";
import Container from "./Container.astro";
import { Icon } from "astro-icon/components";

type Link = {
  title: string;
  url: string;
  icon: string;
};

const socialLinks = [
  {
    title: "Github",
    url: "https://github.com/yourusername",
    icon: "mdi:github",
  },
  {
    title: "LinkedIn",
    url: "https://linkedin.com/in/yourusername",
    icon: "mdi:linkedin",
  },
  {
    title: "Twitter",
    url: "https://twitter.com/yourusername",
    icon: "mdi:twitter",
  },
];

const companyLink = {
  title: "Martech Studios",
  url: "https://martech-studios.com",
};
---

<footer class="pb-6 sm:pb-12 lg:pb-20">
  <Container>
    <div
      class="p-6 rounded-[--card-border-radius] bg-gray-50 mx-auto max-w-sm dark:bg-[--card-dark-bg] sm:p-12"
    >
      <div class="mt-12 mb-6">
        <div class="mb-6">
          <div class="flex items-center justify-center">
            <span class="text-gray-950 dark:text-white font-medium"
              >Connect</span
            >
          </div>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
            {
              socialLinks.map((link: Link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 transition hover:text-primary-600 dark:hover:text-primary-400"
                  >
                    <Icon name={link.icon} class="w-5 h-5" />
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class="text-center pt-4 border-t border-gray-200 dark:border-gray-800"
        >
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Built with Astro
          </p>
        </div>
      </div>
    </div>
  </Container>
</footer>
