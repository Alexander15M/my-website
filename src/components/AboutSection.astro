---
import Container from "./Container.astro";
import { Icon } from "astro-icon/components";
---

<style>
  .highlight {
    transition: color 0.3s ease;
  }
  .highlight:hover {
    color: #3b82f6; /* blue-500 */
  }
</style>

<section
  id="about-me"
  class="bg-gray-50 dark:bg-gray-800 py-12 rounded-lg shadow-md"
>
  <Container>
    <div class="lg:w-2/3 text-center mx-auto">
      <Icon
        name="mdi:account"
        class="w-16 h-16 mx-auto mb-4 text-blue-600 dark:text-blue-400"
      />
      <h2
        class="text-gray-900 dark:text-white font-bold text-2xl sm:text-3xl md:text-5xl my-12"
      >
        About Me
      </h2>
    </div>
    <div class="mt-12 max-w-3xl w-full mx-auto">
      <div class="space-y-3 leading-relaxed">
        <p class="text-gray-600 dark:text-gray-400">
          Hi! I'm Alexander Meneses, a physicist turned software engineer with a
          passion for programming and data science. With over 4 years of
          experience in the industry, I specialize in building scalable web
          applications and data-driven solutions. I've had the opportunity to
          work with various US startups, which has shaped my expertise across
          many areas of web development.
        </p>
        <p class="text-gray-600 dark:text-gray-400">
          Outside of work, I enjoy science, programming, reading, and dancing
          Latin rhythms, especially salsa. I'm always eager to learn and take on
          new challenges, and I'm currently focused on improving my skills in AI
          and machine learning.
        </p>
        <p class="text-gray-600 dark:text-gray-400">
          I believe in continuous learning, hard work, and perseverance, and I'm
          excited to connect with like-minded professionals who share my passion
          for AI, data science, and web development.
        </p>
        <p class="text-gray-600 dark:text-gray-400">
          Currently working at <a
            href="https://martech-studios.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition underline"
            >Martech Studios</a
          >
        </p>
      </div>
    </div>
  </Container>
</section>
