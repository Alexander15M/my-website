---
import { cn } from "@lib/utils";
import Container from "./Container.astro";
import { softGradientVariant as card } from "@tailus/themer-card";

// Get all project files and sort by date (newest first)
let allProjects = [];
try {
  allProjects = await Astro.glob("../pages/projects/*.astro");
} catch (error) {
  // Handle case where no projects exist
  allProjects = [];
}

// Helper function to get project metadata
function getProjectMeta(project: any) {
  // Check if the project exports frontmatter or has it defined
  if (typeof project.default === "function") {
    // For .astro files, we need to extract frontmatter differently
    // Since we can't easily access the frontmatter from glob, we'll use a fallback
    return null;
  }
  return project.frontmatter;
}

// Fallback projects data (your existing projects)
const fallbackProjects = [
  {
    title: "Sara",
    description:
      "Smart Automated Restaurant Assistant for Ordering Food with Voice AI. Streamlining restaurant operations through intelligent voice recognition.",
    href: "/projects/sara",
    coverImage: "/images/sara-cover.jpg",
    icon: "microphone",
    gradient:
      "from-orange-50 to-red-50 dark:from-orange-900/20 dark:to-red-900/20",
    iconColor: "text-orange-600 dark:text-orange-400",
  },
  {
    title: "Loma",
    description:
      "Local marketplace platform connecting communities and enabling seamless local commerce and trade.",
    href: "/projects/loma",
    coverImage: "/images/loma-cover.jpg",
    icon: "shopping",
    gradient:
      "from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20",
    iconColor: "text-green-600 dark:text-green-400",
  },
  {
    title: "Bubble.io JS Plugins",
    description:
      "Custom JavaScript plugins and integrations for Bubble.io no-code platform, extending functionality and capabilities.",
    href: "/projects/bubble-plugins",
    coverImage: "/images/bubble-plugins-cover.jpg",
    icon: "code",
    gradient:
      "from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20",
    iconColor: "text-blue-600 dark:text-blue-400",
  },
  {
    title: "PrivacyBrain",
    description:
      "Backend automation flows for privacy management and data protection, ensuring compliance and security.",
    href: "/projects/privacybrain",
    coverImage: "/images/privacybrain-cover.jpg",
    icon: "shield",
    gradient:
      "from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20",
    iconColor: "text-purple-600 dark:text-purple-400",
  },
  {
    title: "InvestSense",
    description:
      "Investment analysis and portfolio management platform with real-time market data and insights.",
    href: "/projects/investsense",
    coverImage: "/images/investsense-cover.jpg",
    icon: "chart",
    gradient:
      "from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20",
    iconColor: "text-emerald-600 dark:text-emerald-400",
  },
];

// Use fallback projects for now (we can enhance this later to read from actual project files)
const displayProjects = fallbackProjects.slice(0, 5);

// Icon components
const icons = {
  microphone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>`,
  shopping: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>`,
  gallery: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>`,
  code: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>`,
  chart: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>`,
};
---

<section id="projects" class="scroll-mt-24">
  <Container>
    <div class="lg:w-2/3 text-center mx-auto">
      <h2
        class="text-gray-900 dark:text-white font-bold text-2xl sm:text-3xl md:text-5xl my-12"
      >
        My Projects
      </h2>
    </div>
    <div
      class="space-y-4 sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:space-y-0 sm:gap-4"
    >
      {
        displayProjects.map((project) => (
          <a
            href={project.href}
            class={cn(
              card.outer,
              "block hover:scale-105 transition-transform duration-200"
            )}
          >
            <div class={cn(card.inner, "flex flex-col justify-between h-full")}>
              {project.coverImage ? (
                <div class="h-32 overflow-hidden rounded-lg">
                  <img
                    src={project.coverImage}
                    alt={project.title}
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div
                  class={`flex items-center justify-center h-32 bg-gradient-to-br ${project.gradient} rounded-lg`}
                >
                  <svg
                    class={`w-16 h-16 ${project.iconColor}`}
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <Fragment set:html={icons[project.icon]} />
                  </svg>
                </div>
              )}
              <div class="mt-6 space-y-2">
                <h3 class="text-gray-950 dark:text-white text-lg font-medium">
                  {project.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                  {project.description}
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>
