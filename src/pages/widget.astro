---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---

<Layout title="Widget Demo">
  <main class="min-h-screen pt-20 pb-40 overflow-clip">
    <section class="scroll-mt-24">
      <Container>
        <div class="lg:full text-center mx-auto">
          <h1
            class="text-gray-900 dark:text-white font-bold text-2xl sm:text-3xl md:text-5xl my-12"
          >
            Widget Demo
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 mb-12 max-w-2xl mx-auto"
          >
            Enter some text below to interact with the widget
          </p>
        </div>

        <div class="max-w-2xl mx-auto">
          <div
            class="mt-10 p-6 bg-gray-100 dark:bg-gray-900 rounded-lg shadow-xl"
          >
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
              Text Input
            </h2>

            <form class="space-y-4">
              <div>
                <label
                  for="widget-input"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-400 mb-2"
                >
                  Enter your text:
                </label>
                <input
                  type="text"
                  id="widget-input"
                  name="widget-input"
                  placeholder="Type something here..."
                  class="p-3 w-full rounded-md bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white shadow-sm focus:border-purple-500 focus:ring focus:ring-purple-500 focus:ring-opacity-50 transition-colors"
                />
              </div>

              <div>
                <button
                  type="submit"
                  class="w-full py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors"
                >
                  Submit
                </button>
              </div>
            </form>

            <!-- Widget Area - This is where you can place your widget -->
            <div
              class="mt-8 p-4 bg-white dark:bg-gray-800 rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600"
            >
              <p class="text-center text-gray-500 dark:text-gray-400 text-sm">
                Widget will be placed here
              </p>
              <script
                src="https://the-sweet-spot-40-vdpo.vercel.app/widget-embed.js"
                data-widget-agent-name="Test Agent"
                data-widget-agent-email="test@example.com"
                data-widget-agent-phone="(555) 123-4567"
                data-widget-primary-color="#00724F"
                data-widget-simple-mode="true"></script>
            </div>
          </div>
        </div>
      </Container>
    </section>
  </main>
</Layout>
