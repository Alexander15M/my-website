---
import Layout from "../../layouts/Layout.astro";
import Container from "@components/Container.astro";
import { publicAsset } from "@lib/publicAsset";

let allPosts = [];
try {
  allPosts = await Astro.glob("./*.md");
} catch (error) {
  allPosts = [];
}

const posts = allPosts
  .filter((post) => post.frontmatter?.title)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() -
      new Date(a.frontmatter.pubDate).getTime()
  );

function formatDate(dateString: string) {
  const [year, month, day] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function getBlogUrl(url: string) {
  return url.replace("/src/pages", "").replace(".md", "");
}
---

<Layout title="Blog" description="Writing by Alexander Meneses">
  <main class="pt-20 pb-16">
    <Container>
      <div class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <a
            href="/"
            class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Home
          </a>
        </div>

        <h1
          class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4"
        >
          Blog
        </h1>

        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6 max-w-3xl">
          Thoughts, tutorials, and notes on development and the projects I'm
          building.
        </p>
      </div>

      {
        posts.length > 0 ? (
          <div class="space-y-8">
            {posts.map((post) => {
              const cover = publicAsset(post.frontmatter.coverImage);
              return (
                <article class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-6 hover:shadow-lg transition-shadow">
                  {cover && (
                    <img
                      src={cover}
                      alt=""
                      class="mb-4 h-40 w-full rounded-lg object-cover"
                    />
                  )}
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
                    <a
                      href={getBlogUrl(post.url!)}
                      class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                    >
                      {post.frontmatter.title}
                    </a>
                  </h2>

                  <p class="text-gray-600 dark:text-gray-400 mb-4">
                    {post.frontmatter.description}
                  </p>

                  <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-4">
                    <span>By {post.frontmatter.author}</span>
                    <span>•</span>
                    <time datetime={post.frontmatter.pubDate}>
                      {formatDate(post.frontmatter.pubDate)}
                    </time>
                  </div>

                  <a
                    href={getBlogUrl(post.url!)}
                    class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium"
                  >
                    Read More
                    <svg
                      class="w-4 h-4 ml-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="text-gray-600 dark:text-gray-400">No posts yet.</p>
        )
      }
    </Container>
  </main>
</Layout>
