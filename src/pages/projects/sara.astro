---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Gallery from "../../components/Gallery.astro";

// Project metadata
const project = {
  title: "Sara - Voice AI Restaurant Assistant",
  description:
    "Smart Automated Restaurant Assistant for Ordering Food with Voice AI",
  coverImage: "/images/sara-cover.jpg",
  technologies: ["React Native", "Node.js", "OpenAI Whisper", "MongoDB"],
  projectDate: "2023-2024",
  status: "In Development",
};
---

<Layout title={project.title}>
  <main class="pt-20 pb-16">
    <Container>
      <!-- Cover Image -->
      <div class="mb-12 -mx-6 sm:-mx-12">
        <img
          src={project.coverImage || "/cover.webp"}
          alt={project.title}
          class="w-full h-64 md:h-96 object-cover rounded-lg"
        />
      </div>

      <!-- Project Header -->
      <div class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <a
            href="/#projects"
            class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Projects
          </a>
        </div>

        <h1
          class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4"
        >
          {project.title}
        </h1>

        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6 max-w-3xl">
          {project.description}
        </p>

        <div
          class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-8"
        >
          <span>Status: {project.status}</span>
          <span>•</span>
          <span>Year: {project.projectDate}</span>
        </div>

        <!-- Technology Stack -->
        <div class="flex flex-wrap gap-2 mb-8">
          {
            project.technologies.map((tech) => (
              <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 rounded-full text-sm font-medium">
                {tech}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Project Content -->
      <article class="prose prose-lg dark:prose-invert max-w-none mb-16">
        <h2>Project Overview</h2>
        <p>
          Sara is an innovative voice AI assistant designed specifically for
          restaurants to streamline the ordering process. Using advanced speech
          recognition and natural language processing, Sara can understand
          customer orders, ask clarifying questions, and process transactions
          seamlessly.
        </p>

        <h2>Key Features</h2>
        <ul>
          <li>
            <strong>Voice Recognition:</strong> Advanced speech-to-text powered by
            OpenAI Whisper
          </li>
          <li>
            <strong>Natural Language Processing:</strong> Understands complex food
            orders and modifications
          </li>
          <li>
            <strong>Multi-language Support:</strong> Supports English and Spanish
            conversations
          </li>
          <li>
            <strong>Order Management:</strong> Integrates with existing POS systems
          </li>
          <li>
            <strong>Real-time Processing:</strong> Instant order confirmation and
            kitchen integration
          </li>
        </ul>

        <h2>User Interface Screenshots</h2>
        <p>Here are some screenshots of the Sara interface in action:</p>
      </article>

      <!-- Gallery Section -->
      <Gallery
        images={["/product-screenshot.webp", "/cover.webp", "/og.png"]}
        alt="Sara voice AI assistant screenshots"
        columns={2}
      />

      <article class="prose prose-lg dark:prose-invert max-w-none mt-16">
        <h2>Technical Implementation</h2>
        <p>
          The system is built using a modern tech stack with React Native for
          the mobile interface, Node.js for the backend API, and MongoDB for
          data storage. The voice recognition is powered by OpenAI's Whisper
          model, ensuring high accuracy across different accents and languages.
        </p>

        <h2>Demo & Testing</h2>
        <p>
          Sara has been tested in real restaurant environments with positive
          feedback from both staff and customers. The system shows a 40%
          reduction in order processing time and significantly improved order
          accuracy.
        </p>

        <h2>Future Enhancements</h2>
        <ul>
          <li>Integration with popular delivery platforms</li>
          <li>Advanced analytics and reporting dashboard</li>
          <li>Voice authentication for staff access</li>
          <li>AI-powered menu recommendations</li>
        </ul>
      </article>
    </Container>
  </main>
</Layout>
